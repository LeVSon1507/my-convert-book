# Runtime defaults returned by /api/runtime-config.
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=mistralai/mistral-nemo

# Provider API keys. Browser-saved keys still override these at runtime.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
CHATGPT_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
GROK_API_KEY=
HUGGINGFACE_API_KEY=
HF_API_KEY=

# Firebase web app config returned by /api/firebase-config.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

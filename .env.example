# Runtime defaults returned by /api/runtime-config.
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=mistralai/mistral-nemo

# Provider API keys. Browser-saved keys still override these at runtime.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
CHATGPT_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
GROK_API_KEY=
HUGGINGFACE_API_KEY=
HF_API_KEY=

# Firebase web app config returned by /api/firebase-config.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin service account, used server-side by backend translation jobs
# (src/app/api/translate/jobs/*) to read/write Firestore and verify sign-in
# without a browser session. Generate in Firebase Console > Project Settings >
# Service Accounts > Generate new private key. Reuses FIREBASE_PROJECT_ID above.
# Keep the \n escapes in the private key literal when pasting into Vercel.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Bearer secret backend translation jobs use to call their own /tick endpoint
# (self-chaining continuation — see src/lib/translationJobRunner.ts) without a
# user session. Any long random string, e.g. `openssl rand -hex 32`.
INTERNAL_JOB_SECRET=293ccb3e0820b1ee238c9836a402b116eacce9c09ebe6e2d207e6033fd2a21ca

# Bearer secret Vercel Cron sends automatically when calling
# /api/cron/resume-stalled-jobs (the once/day safety net on Hobby — see
# vercel.json). Just needs to exist with this exact name; any random string.
CRON_SECRET=ce214b791309c6166e78a06790996f101b9a140985a47e44cf0267ef29f042a9
